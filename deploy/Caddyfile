# One address for the whole demo: the web app at /, the API at /api. The login cookie
# is only sent to the site that set it, so both have to share an origin.
{$SITE_HOST} {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:8000 {
			# Findings stream over server-sent events, which must not be buffered.
			flush_interval -1
		}
	}

	# The judge's guide and the sample files it links to: plain files, no login.
	redir /judge /judge/ 308
	handle_path /judge/files/* {
		root * /srv/judge-files
		file_server
	}
	handle_path /judge/* {
		root * /srv/judge
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
