# Database
DATABASE_URL=postgresql+psycopg://brandlint:brandlint@db:5432/brandlint
# Production only (deploy/docker-compose.prod.yml): the password of the restricted role the
# API connects as, so Row-Level Security applies to it. Use hex: openssl rand -hex 24
APP_DB_PASSWORD=change-me
# Auth
JWT_SECRET=change-me
# Mock switches (Anoushka builds against mocks until Alapan's services land)
USE_MOCK_ENGINE=true
USE_MOCK_GATEWAY=true
USE_MOCK_MEMORY=true
# Gateway (only the LiteLLM proxy ever sees provider keys)
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=change-me
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:3000
# Optional services
OLLAMA_URL=http://ollama:11434
NEO4J_URL=bolt://neo4j:7687
# Workspace signup (Block 7). Closed unless true. Limits below apply to sandbox workspaces only.
MULTI_TENANT_SIGNUP=false
# The CI/CD integration (docs/ci-integration.md). Off until the rollout in deploy/README.md.
CI_INTEGRATION_ENABLED=false
# CI_BASE_URL=https://your-host      # where the links in a check point (default: WEB_ORIGIN)
# CI_MAX_FILES_PER_RUN=50            # also CI_MAX_BYTES_PER_RUN, CI_MAX_FILE_BYTES,
# CI_MAX_RUNS_PER_DAY=500            # CI_MAX_RUNS_PER_TOKEN_PER_DAY, CI_MAX_BYTES_PER_DAY
# SIGNUPS_PER_HOUR=5            # per client address
# TRUST_PROXY=true              # behind Caddy: use the address it appended to X-Forwarded-For
# SANDBOX_DAYS=7                # how long a sandbox workspace lasts
# SANDBOX_MAX_USERS=10
# SANDBOX_MAX_CONTENT=50
# SANDBOX_MAX_UPLOAD_BYTES=2097152
# SANDBOX_MAX_REVIEWS_PER_DAY=20
# SANDBOX_MAX_LLM_CALLS_PER_DAY=300
