# Production build for the public demo. NEXT_PUBLIC_* values are fixed at build time,
# so the API address and demo mode are build arguments, not runtime settings.
FROM node:22.23.4-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEMO_MODE=false
ARG NEXT_PUBLIC_MULTI_TENANT_SIGNUP=false
ARG NEXT_PUBLIC_CI_ENABLED=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_DEMO_MODE=$NEXT_PUBLIC_DEMO_MODE \
    NEXT_PUBLIC_MULTI_TENANT_SIGNUP=$NEXT_PUBLIC_MULTI_TENANT_SIGNUP \
    NEXT_PUBLIC_CI_ENABLED=$NEXT_PUBLIC_CI_ENABLED \
    NEXT_TELEMETRY_DISABLED=1
RUN npx next build

FROM node:22.23.4-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/next.config.ts ./
USER node
EXPOSE 3000
CMD ["npx", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
